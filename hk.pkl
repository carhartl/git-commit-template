amends "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Builtins.pkl"

steps {
  ["actionlint"] = Builtins.actionlint
  ["golangci-lint"] = Builtins.golangci_lint
  ["mise"] = Builtins.mise
  ["newlines"] = Builtins.newlines
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["prettier"] = Builtins.prettier
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["yamllint"] = (Builtins.yamllint) {
    check =
      "yamllint -d '{extends: default, rules: {line-length: {max: 120}, comments: disable}}' -s {{ files }}"
  }
}
